      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 457548,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Adjusts cutoffs in real time: Cutoff_adj = Cutoff_base + Offset_Cat + Offset_Round.\n\u2022 Applies category shifts (OBC: -0.75%, SC: -4.20%) and round relaxation (R2: -0.65%).",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2022 Adjusts cutoffs in real time: Cutoff_adj = Cutoff_base + Offset_Cat + Offset_Round.\n\u2022 Applies category shifts (OBC: -0.75%, SC: -4.20%) and round relaxation (R2: -0.65%).",
      "lineHeight": 1.25
    },
