      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "\u2022 Auto-balances choices: 30% Dream (Pref 1-3), 40% Target (Pref 4-7), 30% Safe (Pref 8-10).\n\u2022 Strict Discipline Preservation ensures student's branch (CS) is never swapped for Civil.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "\u2022 Auto-balances choices: 30% Dream (Pref 1-3), 40% Target (Pref 4-7), 30% Safe (Pref 8-10).\n\u2022 Strict Discipline Preservation ensures student's branch (CS) is never swapped for Civil.",
